# --- Server ---
PORT=4000
# Public base URL of this server (used to build media URLs with local storage)
PUBLIC_BASE_URL=http://localhost:4000

# --- Style transfer provider ---
# "mock"      = free local FFmpeg cartoon filter (pipeline validation, no API key needed)
# "replicate" = real AI style transfer via Replicate
STYLE_PROVIDER=mock
REPLICATE_API_TOKEN=
# img2img / style-transfer model, e.g. "owner/model" or "owner/model:versionhash".
# Kept configurable so the model can be swapped without code changes.
REPLICATE_MODEL=

# --- Storage for finished videos ---
# "local" = ./data/media served at /media (development)
# "supabase" = Supabase Storage bucket (production)
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=toonify-videos

# --- Cost guardrails ---
# Hard cap on uploaded video duration (validated server-side)
MAX_VIDEO_SECONDS=30
MAX_UPLOAD_MB=100
# Frames are extracted at this fps, NOT the source fps (12fps of a 30s clip
# = 360 paid API calls vs 900 at 30fps)
PROCESS_FPS=12
# Frames are downscaled to this width before stylizing
MAX_FRAME_WIDTH=720
# How many frames are stylized in parallel
FRAME_CONCURRENCY=2

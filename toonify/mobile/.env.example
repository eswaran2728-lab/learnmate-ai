# Backend API. Leave unset in development — the app falls back to the machine
# running the Expo dev server on port 4000, which works for simulators and
# LAN devices out of the box.
EXPO_PUBLIC_API_URL=

# Supabase (auth). Optional — without these the app runs in dev mode with
# accounts disabled.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

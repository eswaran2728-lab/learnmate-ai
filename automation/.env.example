# --- n8n (Phase 1) ---
N8N_HOST=n8n.yourdomain.com
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
TZ=Asia/Kuala_Lumpur

# --- WhatsApp Cloud API (Phase 2) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Gemini (Phase 3) ---
GEMINI_API_KEY=

# --- Google Sheets (Phase 3 & 5) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
# Service account or OAuth2 credential is configured inside n8n's credential manager,
# not as an env var. This ID is referenced by the workflow JSON's placeholder.

# --- TikTok Shop Open API (Phase 4) ---
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_CIPHER=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Telegram (Phase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
